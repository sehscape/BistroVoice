# Copy to .env and fill in. .env is git-ignored. Everything here is free.

# --- LLM -----------------------------------------------------------------------
# Any OpenAI-compatible endpoint works. Default is Groq's free tier
# (key from https://console.groq.com/keys, no card needed).
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Fully local alternative (no key): install Ollama, `ollama pull qwen2.5:7b`, then
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# --- Speech ----------------------------------------------------------------------
# faster-whisper model: tiny.en / base.en / small.en (downloaded on first use)
STT_MODEL=base.en
# Piper voice used for the agent (downloaded by `bistrovoice download-models`)
TTS_VOICE=en_GB-jenny_dioco-medium

# --- Storage ---------------------------------------------------------------------
DB_PATH=var/bistrovoice.db
